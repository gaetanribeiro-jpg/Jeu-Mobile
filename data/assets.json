{
  "_readme": "Table de correspondance des assets Tiny Swords. Le chemin complet d'une entree est : res:// + meta.roots[categorie] + chemin relatif. Pour les unites et les batiments, path_template accepte {color} (une des meta.colors) et {file}. Nombre d'images = largeur du PNG / hauteur ; le cadre est carre (frame x frame). Ne jamais coder un chemin en dur ailleurs que dans ce fichier. Verifier apres toute mise a jour du pack : godot --headless --path . -s tools/verify_assets.gd",
  "meta": {
    "tile_size": 64,
    "fps": 10,
    "colors": [
      "Blue",
      "Red",
      "Purple",
      "Yellow",
      "Black"
    ],
    "root_free": "assets/tiny_swords/free/",
    "root_enemy": "assets/tiny_swords/enemy/",
    "roots": {
      "units": "free",
      "buildings": "free",
      "terrain": "free",
      "decorations": "free",
      "resources": "free",
      "fx": "free",
      "ui": "free",
      "enemies": "enemy",
      "extra": "enemy"
    }
  },
