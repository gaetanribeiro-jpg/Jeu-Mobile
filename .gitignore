# On garde les dossiers (via .gitkeep) pour qu'ils existent sur un clone
# neuf : sinon il faut les créer à la main avant de copier le pack, et
# rien ne dit où.
assets/tiny_swords/free/*
assets/tiny_swords/enemy/*
!assets/tiny_swords/free/.gitkeep
!assets/tiny_swords/enemy/.gitkeep

